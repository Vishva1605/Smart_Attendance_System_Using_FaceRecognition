<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Instructions -->
        <TextView
            android:id="@+id/tv_instructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/face_verification_title"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary"
            android:background="@color/white"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp" />

        <!-- Student Info -->
        <TextView
            android:id="@+id/tv_student_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/student_info_title"
            android:textSize="14sp"
            android:textColor="#666"
            android:background="#fff"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp" />

        <!-- Face Comparison -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/registered_face"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <ImageView
                    android:id="@+id/iv_reference_face"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:background="@color/image_placeholder"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/desc_registered_face_image"
                    android:elevation="4dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VS"
                android:textSize="16sp"
                android:textColor="#666"
                android:textStyle="bold"
                android:layout_marginHorizontal="16dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/current_photo"
                    android:textSize="12sp"
                    android:textColor="#333"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <ImageView
                    android:id="@+id/iv_current_face"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:background="#ddd"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/desc_current_face_image"
                    android:elevation="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Verification Status -->
        <TextView
            android:id="@+id/tv_verification_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:textColor="#666"
            android:background="#fff"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp" />

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <!-- Buttons -->
        <Button
            android:id="@+id/btn_capture_face"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/capture_face_verification"
            android:background="@color/success_color"
            android:textColor="@color/white"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_verify_again"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/try_again"
            android:background="@color/warning_color"
            android:textColor="@color/white"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/back"
            android:background="@color/text_secondary"
            android:textColor="@color/white"
            android:padding="12dp" />
    </LinearLayout>
</ScrollView>
